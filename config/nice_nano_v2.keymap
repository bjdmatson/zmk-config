#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &foostan_corne_5col_layout; };

    behaviors {
        lh_balanced: lh_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_BALANCED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        rh_balanced: rh_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_BALANCED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        sym_slash: sym_slash {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_SLASH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            mods = <(MOD_RSFT)>;
        };

        sym_tlde_tick: sym_tlde_tick {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_TLDE_TICK";
            bindings = <&kp GRAVE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_dash: sym_dash {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_DASH";
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_qstn_excl: sym_qstn_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_QSTN_EXCL";
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_perc_amp: sym_perc_amp {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_PERC_AMP";
            bindings = <&kp AMPERSAND>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        arrow_dance: arrow_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ARROW_DANCE";
            #binding-cells = <0>;
            bindings = <&dash_arrow>, <&equal_arrow>;
        };

        sym_pipe_hash: sym_pipe_hash {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_PIPE_HASH";
            bindings = <&kp PIPE>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_tags: sym_tags {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_TAGS";
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_brackets: sym_brackets {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_BRACKETS";
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_braces: sym_braces {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_BRACES";
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        sym_parens: sym_parens {
            compatible = "zmk,behavior-mod-morph";
            label = "SYM_PARENS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps-lock {
            bindings = <&caps_word>;
            key-positions = <10 19>;
        };
    };

    macros {
        dash_arrow: dash_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "DASH_ARROW";
        };

        equal_arrow: equal_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "EQUAL_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
  &kp SEMICOLON          &kp COMMA             &kp DOT              &kp P                &lh_balanced LA(LC(LSHIFT)) Y            &rh_balanced RA(RC(RSHIFT)) F           &kp G                &kp C                &kp R                 &kp L
  &lh_balanced LSHIFT A  &lh_balanced LCTRL O  &lh_balanced LALT E  &lh_balanced LGUI U  &lh_balanced LA(LC(LG(LEFT_SHIFT))) I    &rh_balanced RG(RA(RC(RIGHT_SHIFT))) D  &rh_balanced RGUI H  &rh_balanced LALT T  &rh_balanced RCTRL N  &rh_balanced RSHIFT S
  &kp SINGLE_QUOTE       &kp Q                 &kp J                &kp K                &kp X                                    &kp B                                   &kp M                &kp W                &kp V                 &kp Z
                                               &lt 3 DELETE         &lt 1 TAB            &lt 2 SPACE                              &lt 4 BACKSPACE                         &lt 5 ENTER          &lt 6 ESCAPE
            >;

            label = "Base";
            display-name = "Base";
        };

        Numbers {
            bindings = <
  &none       &none      &none     &none     &kp LA(LC(LSHIFT))      &kp SLASH   &kp N7        &kp N8        &kp N9        &kp PLUS
  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI  &kp LS(LC(LA(LGUI)))    &none       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
  &none       &none      &none     &none     &none                   &none       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp STAR
                         &none     &none     &none                   &kp PERIOD  &kp N0        &kp ENTER
            >;

            label = "Nums";
            display-name = "Numbers";
        };

        Navigation {
            bindings = <
  &none       &none      &none     &none     &kp LA(LC(LSHIFT))      &kp LG(LS(Z))  &kp LG(C)  &kp LG(V)      &kp LG(X)     &kp LG(Z)
  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI  &kp LS(LA(LC(LGUI)))    &kp CAPS       &kp LEFT   &kp DOWN       &kp UP_ARROW  &kp RIGHT
  &none       &none      &none     &none     &none                   &none          &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP   &kp END
                         &none     &none     &none                   &trans         &trans     &trans
            >;

            label = "Nav";
            display-name = "Nav";
        };

        Mouse {
            bindings = <
  &none       &none      &none     &none     &kp LA(LC(LSHIFT))      &kp LS(LG(Z))  &kp LG(C)       &kp LG(V)       &kp LG(X)     &kp LG(Z)
  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI  &kp LS(LA(LC(LGUI)))    &none          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
  &none       &none      &none     &none     &none                   &none          &none           &none           &none         &none
                         &none     &none     &none                   &mkp MB1       &mkp MB2        &mkp MB3
            >;

            label = "Mouse";
        };

        Symbols {
            bindings = <
  &kp LEFT_BRACKET      &sym_slash  &sym_perc_amp  &kp RIGHT_BRACKET      &kp EQUAL       &kp RA(RC(RSHFT))     &trans    &trans    &trans     &trans
  &kp LEFT_PARENTHESIS  &kp CARET   &arrow_dance   &kp RIGHT_PARENTHESIS  &kp MINUS       &kp RS(RA(RC(RGUI)))  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHIFT
  &sym_tlde_tick        &kp HASH    &kp AT_SIGN    &kp EXCLAMATION        &kp QUESTION    &trans                &trans    &trans    &trans     &trans
                                    &kp CARET      &kp ASTERISK           &kp DOLLAR      &trans                &trans    &trans
            >;

            label = "Symbl";
            display-name = "Symbl";
        };

        Media {
            bindings = <
  &bt BT_SEL 0   &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4    &kp RC(RA(RSHIFT))    &gresc    &none     &none      &none
  &kp C_MUTE     &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &none         &out OUT_TOG    &kp RS(RA(RC(RGUI)))  &kp RGUI  &kp RALT  &kp RCTRL  &kp RSHIFT
  &kp LC(LG(Q))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none         &bt BT_CLR      &none                 &none     &none     &none      &none
                                       &kp C_PREVIOUS        &kp C_NEXT    &kp C_PP        &none                 &none     &none
            >;

            label = "Media";
            display-name = "M";
        };

        Func {
            bindings = <
  &kp F10  &kp F7  &kp F8  &kp F9  &none    &none  &none  &none  &none  &none
  &kp F11  &kp F4  &kp F5  &kp F6  &none    &none  &none  &none  &none  &none
  &kp F12  &kp F1  &kp F2  &kp F3  &none    &none  &none  &none  &none  &none
                   &none   &none   &none    &none  &none  &none
            >;

            label = "Func";
        };
    };
};
